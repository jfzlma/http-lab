# HTTP Lab configuration.
# Copy to .env and adjust. Never commit real secrets.

# --- General ---
APP_ENV=development              # development | production | test
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_REQUESTS=true                # set false to disable request logging entirely

# --- Safety limits (hosted service hardening) ---
MAX_DELAY_MS=30000               # max delay endpoint value (hosted: keep low)
MAX_REDIRECTS=20                 # max redirect chain length
MAX_RESPONSE_SIZE_MB=10          # cap for /response-size and /response body override
MAX_REQUEST_BODY_MB=1            # max accepted request body
CONCURRENT_SLOW_REQUESTS=50      # max simultaneous delayed/large responses

# --- Rate limiting (global safeguard, per client IP) ---
RATE_LIMIT_ENABLED=false         # enable guardrails on hosted deployments
RATE_LIMIT_REQUESTS=120          # requests allowed per window
RATE_LIMIT_WINDOW=60             # window in seconds
# Optional: share rate-limit state across workers, e.g. redis://redis:6379/0
# (needs the 'redis' extra). Keep comments on their own line for empty values.
REDIS_URL=

# --- Client IP resolution ---
TRUSTED_PROXY_COUNT=0            # number of trusted reverse proxies in front of the app

# --- IP intelligence ---
# local  = basic local-only determination (no external calls, fields marked unavailable)
# ipinfo = https://ipinfo.io (requires IP_INTELLIGENCE_API_KEY)
# ipapi  = https://ipapi.co (free tier, no key required)
IP_INTELLIGENCE_PROVIDER=local
IP_INTELLIGENCE_API_KEY=
IP_INFO_TIMEOUT=2                # seconds
IP_INFO_CACHE_TTL=3600           # seconds

# --- CORS ---
# Comma-separated list of allowed origins. The UI is same-origin, so CORS is
# only needed if you call the API from another web app. Empty = same-origin only.
CORS_ORIGINS=
